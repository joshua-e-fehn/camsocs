{
  "name": "camsocs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bash scripts/convex-deploy-if-key.sh && bash scripts/build-env-defaults.sh next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:codegen": "bun run scripts/check-codegen.ts",
    "test": "bun test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "prepare": "cd .. && husky webapp/.husky"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "better-auth": "~1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "convex": "^1.44.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.4.7",
    "@happy-dom/global-registrator": "^20.11.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^25",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.55",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
