# Copy to `.env.local` and fill in — or let `bunx convex dev` write the Convex
# lines for you. Only NEXT_PUBLIC_* values (and CONVEX_DEPLOYMENT) belong here;
# secrets live on the Convex deployment, see below.
#
# NEXT_PUBLIC_CONVEX_URL and NEXT_PUBLIC_CONVEX_SITE_URL are needed at *build*
# time: lib/auth-server.ts validates them (lib/convex-url.ts) while Next.js
# collects page data. scripts/build-env-defaults.sh substitutes a placeholder
# pair only for a build that is not being deployed.

# --- Convex (written by `bunx convex dev`) ---
CONVEX_DEPLOYMENT=dev:<deployment-name> # team: <team>, project: camsocs

# The deployment's API URL, used by the browser client. …convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://<deployment-name>.convex.cloud

# The deployment's *site* URL: Better Auth and /api/pipeline/* live here. …convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment-name>.convex.site

# Where this app is served from.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Set on the Convex deployment, NOT here ---
# Better Auth runs inside Convex, so these are read there; a value in this file
# would simply not be seen. Add `--prod` for production.
#
#   bunx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   bunx convex env set SITE_URL http://localhost:3000        # the public origin in prod
#   bunx convex env set GOOGLE_CLIENT_ID <>                   # optional until sign-in is needed
#   bunx convex env set GOOGLE_CLIENT_SECRET <>
#   bunx convex env set PIPELINE_API_KEY "$(openssl rand -hex 32)"
#   bunx convex env set BROKER_EMAILS "you@example.com"       # unset = nobody has broker access
#   bunx convex env set RESEND_API_KEY re_…                   # @cam.ac.uk sign-in link; both unset = option off
#   bunx convex env set RESEND_FROM "camsocs <sign-in@<verified domain>>"
#
# Google OAuth callback (dev and prod): <SITE_URL>/api/auth/callback/google —
# the app's own origin, which app/api/auth/[...all]/route.ts proxies to Convex.
#
# ⚠ Never export CONVEX_DEPLOY_KEY in a shell. It overrides .env.local and has
# deployed one project's functions onto another project's production before.
# It belongs only in Vercel's production environment.
