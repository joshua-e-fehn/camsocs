# The request job runner, every minute (ENG-158). /opt/camsocs/docs/ops-vps.md §13.
[Unit]
Description=camsocs request jobs, every minute
Documentation=file:/opt/camsocs/docs/ops-vps.md

[Timer]
OnBootSec=4min
OnUnitActiveSec=1min
AccuracySec=5s
Persistent=false
Unit=camsocs-request-jobs.service

[Install]
WantedBy=timers.target
