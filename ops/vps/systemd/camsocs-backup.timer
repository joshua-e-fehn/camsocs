# The nightly backup of Convex production (ENG-44). /opt/camsocs/docs/ops-vps.md §10.
[Unit]
Description=camsocs nightly backup of Convex production (01:30 Europe/London)
Documentation=file:/opt/camsocs/docs/ops-vps.md

[Timer]
# Before the Sunday full harvest (02:00) and the daily one (04:30), and before
# Convex's retention-daily cron (04:15 UTC): a backup sees the night's data
# before the night's deletions. 01:30 exists exactly once on both
# clock-change Sundays in London.
OnCalendar=*-*-* 01:30:00 Europe/London
# A night missed while the host was down is backed up once at the next boot.
Persistent=true
Unit=camsocs-backup.service

[Install]
WantedBy=timers.target
