# The Slack DM for a failed camsocs harvest; %i is the group. Started by
# camsocs-harvest@%i.service's OnFailure=, or by hand to test the alert path:
# `systemctl start camsocs-alert@events.service` (sends a real DM).
# Decision D5 and the runbook: /opt/camsocs/docs/ops-vps.md "Alerts". Installed
# by install.sh from a reviewed commit; the script is root-owned in
# /usr/local/lib/camsocs-ops/, never run from the checkout the harvest writes.
[Unit]
Description=camsocs harvest failure alert (%i group)
Documentation=file:/opt/camsocs/docs/ops-vps.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Not the harvest's user: a user of its own for each run, in the camsocs group
# only to read the status file (/var/lib/camsocs is 0750, the file 0640).
DynamicUser=yes
SupplementaryGroups=camsocs
ExecStart=/usr/bin/python3 -I /usr/local/lib/camsocs-ops/camsocs-alert.py %i
# The three Slack values only, which install.sh extracted from Mya's env file
# into this root-owned 0600 file; systemd hands the unit a read-only copy only
# it can read, for as long as it runs.
LoadCredential=slack-env:/etc/camsocs/alert.env
Environment=CAMSOCS_ALERT_ENV=%d/slack-env
Environment=CAMSOCS_STATE_DIR=/var/lib/camsocs
TimeoutStartSec=2min

# --- hardening: it reads one status file and talks to slack.com ---------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Mya's data, Docker, root's files, the checkout (with the pipeline's keys)
# and the logs are out of its reach.
InaccessiblePaths=-/docker -/var/lib/docker -/run/docker.sock -/root -/opt/camsocs -/var/log/camsocs
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
